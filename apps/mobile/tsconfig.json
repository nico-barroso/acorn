{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mobile/lib/*": ["lib/*"],
      "@mobile/app/*": ["app/*"],
      "@mobile/assets/*": ["assets/*"],
    },
  },
}
